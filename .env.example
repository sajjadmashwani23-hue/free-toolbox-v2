# Optional Google Search Console verification token (value supplied by Search Console).
VITE_GOOGLE_SITE_VERIFICATION=

# Optional GA4 measurement ID (e.g. G-XXXXXXXXXX). Loaded only AFTER the visitor accepts the cookie prompt.
VITE_GA_MEASUREMENT_ID=

# Optional AdSense, only after Google approves the site. Leave blank until approval.
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_TOP=
VITE_ADSENSE_SLOT_IN_CONTENT=
VITE_ADSENSE_SLOT_BELOW_TOOL=
VITE_ADSENSE_SLOT_SIDEBAR=
